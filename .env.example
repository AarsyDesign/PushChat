# Pushchat Service Configuration

# Port Pushchat mandiri
PORT=8092

# Path database bersama PushNotif (Shared Auth & Saldo QRIS)
PUSHNOTIF_DB_PATH=/opt/data/work/pushnotif/pushnotif.db

# Path database spesifik Pushchat (aturan auto-reply, postingan IG, log percakapan)
PUSHCHAT_DB_PATH=/opt/data/work/pushchat/pushchat.db

# Kredensial Meta Graph API (Instagram / Threads)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=pushchat_meta_verify_2026
INSTAGRAM_PAGE_ACCESS_TOKEN=
